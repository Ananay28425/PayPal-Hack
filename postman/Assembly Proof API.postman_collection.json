  "item": [
    {
      "name": "Get All Counterexamples",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Response has required top-level keys\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"summary\");",
              "    pm.expect(body).to.have.property(\"groups\");",
              "    pm.expect(body).to.have.property(\"cases\");",
              "});",
              "",
              "pm.test(\"Summary has required fields\", function () {",
              "    const summary = pm.response.json().summary;",
              "    pm.expect(summary.total).to.be.a(\"number\");",
              "    pm.expect(summary.passed).to.be.a(\"number\");",
              "    pm.expect(summary.failed).to.be.a(\"number\");",
              "});",
              "",
              "pm.test(\"Summary totals are consistent\", function () {",
              "    const summary = pm.response.json().summary;",
              "    pm.expect(summary.passed + summary.failed).to.equal(summary.total);",
              "});",
              "",
              "pm.test(\"Cases is an array\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.cases).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Each case has required fields\", function () {",
              "    const cases = pm.response.json().cases;",
              "    cases.forEach(function (c, i) {",
              "        pm.expect(c, \"case[\" + i + \"] missing 'scenario'\").to.have.property(\"scenario\");",
              "        pm.expect(c, \"case[\" + i + \"] missing 'category'\").to.have.property(\"category\");",
              "        pm.expect(c, \"case[\" + i + \"] missing 'rationale'\").to.have.property(\"rationale\");",
              "        pm.expect(c, \"case[\" + i + \"] missing 'expected'\").to.have.property(\"expected\");",
              "        pm.expect(c, \"case[\" + i + \"] missing 'observed'\").to.have.property(\"observed\");",
              "        pm.expect(c, \"case[\" + i + \"] missing 'passed'\").to.have.property(\"passed\");",
              "    });",
              "});",
              "",
              "pm.test(\"Each case 'passed' field is a boolean\", function () {",
              "    const cases = pm.response.json().cases;",
              "    cases.forEach(function (c, i) {",
              "        pm.expect(c.passed, \"case[\" + i + \"] 'passed' is not a boolean\").to.be.a(\"boolean\");",
              "    });",
              "});",
              "",
              "pm.test(\"Groups exist\", function () {",
              "    const groups = pm.response.json().groups;",
              "    pm.expect(groups).to.have.property(\"configuration\");",
              "    pm.expect(groups).to.have.property(\"payment_integrity\");",
              "});",
              "",
              "pm.test(\"Group totals match case counts\", function () {",
              "    const groups = pm.response.json().groups;",
              "    Object.keys(groups).forEach(function (key) {",
              "        const group = groups[key];",
              "        pm.expect(group.total, \"group '\" + key + \"' total mismatch\").to.equal(group.cases.length);",
              "    });",
              "});",
              "",
              "pm.test(\"All 10 counterexamples are present\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.summary.total).to.eql(10);",
              "});",
              "",
              "pm.test(\"All counterexamples passed\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.summary.passed).to.eql(10);",
              "    pm.expect(body.summary.failed).to.eql(0);",
              "});",
              "",
              "pm.test(\"Configuration group has 4 cases\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.groups.configuration.total).to.eql(4);",
              "    pm.expect(body.groups.configuration.passed).to.eql(4);",
              "});",
              "",
              "pm.test(\"Payment integrity group has 6 cases\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.groups.payment_integrity.total).to.eql(6);",
              "    pm.expect(body.groups.payment_integrity.passed).to.eql(6);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/counterexamples/all",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8000",
          "path": [
            "api",
            "counterexamples",
            "all"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Configuration Counterexamples",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Response has 'cases' array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"cases\");",
              "    pm.expect(jsonData.cases).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Response has 'scope' string\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"scope\");",
              "    pm.expect(jsonData.scope).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"Each case has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.cases.forEach(function (item) {",
              "        pm.expect(item).to.have.property(\"scenario\");",
              "        pm.expect(item).to.have.property(\"category\");",
              "        pm.expect(item).to.have.property(\"rationale\");",
              "        pm.expect(item).to.have.property(\"expected\");",
              "        pm.expect(item).to.have.property(\"observed\");",
              "        pm.expect(item).to.have.property(\"passed\");",
              "    });",
              "});",
              "",
              "pm.test(\"Each case 'passed' field is a boolean\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.cases.forEach(function (item) {",
              "        pm.expect(typeof item.passed).to.equal(\"boolean\");",
              "    });",
              "});",
              "",
              "pm.test(\"All cases passed\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.cases.forEach(function (item) {",
              "        pm.expect(item.passed).to.equal(true);",
              "    });",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
