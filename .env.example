# Use a unique secret of at least 12 characters. Demo token is not production identity.
ASSEMBLY_DEMO_TOKEN=replace-with-a-long-random-value
ASSEMBLY_PAYMENT_MODE=mock
ASSEMBLY_DATABASE_URL=sqlite:///./assembly-demo.db
ASSEMBLY_PUBLIC_URL=http://127.0.0.1:8000

# Set these only for live PayPal Sandbox checkout:
# ASSEMBLY_PAYMENT_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# ASSEMBLY_PUBLIC_URL=https://your-public-host.example

# Optional AI requirement extraction:
# OPENAI_API_KEY=
# ASSEMBLY_AI_MODEL=gpt-4.1-mini

# Optional sponsor integrations. Set values in the server environment.
# CHANNEL3_API_KEY=
