# Copy this file to .env. Use a unique demo token of at least 12 characters.
ASSEMBLY_DEMO_TOKEN=replace-with-a-long-random-value
ASSEMBLY_PAYMENT_MODE=mock
ASSEMBLY_DATABASE_URL=sqlite:///./assembly-demo.db
ASSEMBLY_PUBLIC_URL=http://127.0.0.1:8010

# PayPal Sandbox merchant app credentials. Set payment mode to sandbox to use them.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional AI planning. Set only your OpenRouter key for free inference.
OPENROUTER_API_KEY=
ASSEMBLY_OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# Direct OpenAI alternative:
# OPENAI_API_KEY=
# ASSEMBLY_AI_MODEL=gpt-4.1-mini

# Optional product discovery.
CHANNEL3_API_KEY=
