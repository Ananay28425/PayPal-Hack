digraph G {
graph [rankdir=TB, bgcolor="#F8FBFD", pad="0.32", nodesep="0.35", ranksep="0.62", splines=polyline, fontname="Segoe UI", fontsize=21, labelloc=t, label="A2 | Purchase, approval and payment flow"];
node [shape=box, style="rounded,filled", fillcolor="white", color="#ADC4D2", penwidth=1.0, fontname="Segoe UI", fontsize=12, fontcolor="#132E44", margin="0.16,0.12"];
edge [color="#54778D", penwidth=1.15, arrowsize=0.7, fontname="Segoe UI", fontsize=10, fontcolor="#355B70"];
"intent" [label="1. Buyer supplies outcome, budget and deadline", shape=box, fillcolor="#FFFFFF"];
"facts" [label="2. AI proposes requirements and product facts\nretain provenance and critical unknowns", shape=box, fillcolor="#FFF2D9"];
"check" [label="3. Deterministic configuration and readiness checks", shape=box, fillcolor="#E3EFF8"];
"valid" [label="Critical constraints satisfied?", shape=diamond, fillcolor="#E3EFF8"];
"revise" [label="Show conflict / unknown / useful repair\nuser or trusted evidence resolves it", shape=box, fillcolor="#FCE8E6"];
"offer" [label="4. Freeze merchant offer and material manifest\nmerchant / variant / quantity / total / currency / expiry", shape=box, fillcolor="#E3EFF8"];
"approve" [label="5. Authenticated user accepts exact terms\nstore consent and policy version", shape=box, fillcolor="#E3EFF8"];
"create" [label="6. Persist order-create intent, then call PayPal\nstable create key; store provider order ID", shape=box, fillcolor="#E3EFF8"];
"buyerpp" [label="7. Buyer approves the order at PayPal\nbrowser callback is a signal, not payment evidence", shape=box, fillcolor="#FFFFFF"];
"commit" [label="8. Recheck material version and authority\natomic budget / inventory reservation + capture intent", shape=box, fillcolor="#E3EFF8"];
"send" [label="9. Worker dispatches capture outside DB transaction\noriginal order / body hash / stable capture key", shape=box, fillcolor="#E3EFF8"];
"result" [label="Trusted outcome?", shape=diamond, fillcolor="#E3EFF8"];
"unknown" [label="Unknown: retain reservation and operation\nread back / exact retry under provider contract\nnever mint replacement authority on timeout", shape=box, fillcolor="#FCE8E6"];
"declined" [label="Terminal no-effect outcome\nrecord refusal; release only justified reservations\nshow next action without fulfillment", shape=box, fillcolor="#FCE8E6"];
"confirmed" [label="10. Record verified completed capture\nmatch merchant, amount and currency", shape=box, fillcolor="#E3EFF8"];
"outbox" [label="11. Commit fulfillment outbox atomically\nunique purchase commitment + replay-safe consumer", shape=box, fillcolor="#E6F4EF"];
"task" [label="12. Approved external setup task\nindependent from financial success", shape=box, fillcolor="#E6F4EF"];
"intent" -> "facts" [label="", style=solid];
"facts" -> "check" [label="", style=solid];
"check" -> "valid" [label="", style=solid];
"valid" -> "offer" [label="", style=solid];
"offer" -> "approve" [label="", style=solid];
"approve" -> "create" [label="", style=solid];
"create" -> "buyerpp" [label="", style=solid];
"buyerpp" -> "commit" [label="", style=solid];
"commit" -> "send" [label="", style=solid];
"send" -> "result" [label="", style=solid];
"result" -> "confirmed" [label="completed capture", style=solid];
"confirmed" -> "outbox" [label="", style=solid];
"outbox" -> "task" [label="", style=solid];
"valid" -> "revise" [label="no", style=solid];
"revise" -> "facts" [label="new version", style=solid];
"result" -> "unknown" [label="ambiguous", style=solid];
"unknown" -> "result" [label="resource evidence", style=solid];
"result" -> "declined" [label="terminal no effect", style=solid];
}