"pp" [label="PayPal\nbuyer approval / capture / verification", shape=box, fillcolor="#E3EFF8"];
"task" [label="Approved setup task\nZapier; after verified payment", shape=box, fillcolor="#E6F4EF"];
"qa" [label="Isolated Counterexample\nAPIMatic development context\nPostman independent regressions", shape=box, fillcolor="#EEE9FA"];
"routing" [label="Regional request routing\ncurrent owner for money; local reads\nownership metadata in financial SQL", shape=box, fillcolor="#E3EFF8"];
"cell_a" [label="Region A: Render application cell\nsame FastAPI code + bounded workers\nper-tenant admission and recovery capacity", shape=box, fillcolor="#E3EFF8"];
"cell_b" [label="Region B: Render application cell\nsame FastAPI code + bounded workers\nper-tenant admission and recovery capacity", shape=box, fillcolor="#E3EFF8"];
"sql" [label="Managed distributed financial SQL\nexplicit SERIALIZABLE transactions\nregion-survival quorum: 3+ permitted DB regions\nversions / reservations / inbox / outbox", shape=cylinder, fillcolor="#E3EFF8"];
"ui" -> "edge" [label="", style=solid];
"edge" -> "routing" [label="authenticated application requests", style=solid];
"routing" -> "cell_a" [label="current owner", style=solid];
"routing" -> "cell_b" [label="current owner", style=solid];
